---
interface Props {
	name:
		| 'arrow-left'
		| 'arrow-right'
		| 'external'
		| 'github'
		| 'briefcase'
		| 'calendar'
		| 'status'
		| 'layers'
		| 'work'
		| 'spark';
	size?: number;
	class?: string;
}

const { name, size = 16, class: className = '' } = Astro.props;
const stroke = 1.75;
---

<svg
	class:list={['icon', className]}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	aria-hidden="true"
	focusable="false"
>
	{
		name === 'arrow-left' && (
			<path
				d="M15.5 5.5 9 12l6.5 6.5M9 12h10"
				stroke="currentColor"
				stroke-width={stroke}
				stroke-linecap="round"
				stroke-linejoin="round"
			/>
		)
	}
	{
		name === 'arrow-right' && (
			<path
				d="M8.5 5.5 15 12l-6.5 6.5M15 12H5"
				stroke="currentColor"
				stroke-width={stroke}
				stroke-linecap="round"
				stroke-linejoin="round"
			/>
		)
	}
	{
		name === 'external' && (
			<>
				<path
					d="M14 5h5v5"
					stroke="currentColor"
					stroke-width={stroke}
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
				<path
					d="M19 5 11 13"
					stroke="currentColor"
					stroke-width={stroke}
					stroke-linecap="round"
				/>
				<path
					d="M10 6H7a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-3"
					stroke="currentColor"
					stroke-width={stroke}
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</>
		)
	}
	{
		name === 'github' && (
			<path
				d="M9.5 19.5c-4 1.3-4-2-5.5-2.5M15.5 21v-2.7a2.9 2.9 0 0 0-.8-2.2c2.7-.3 5.5-1.3 5.5-6a4.6 4.6 0 0 0-1.2-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.3 1.2a11.4 11.4 0 0 0-6 0C7 3.7 6 4 6 4a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 4.7 10.4c0 4.7 2.8 5.7 5.5 6a2.9 2.9 0 0 0-.8 2.2V21"
				stroke="currentColor"
				stroke-width={stroke}
				stroke-linecap="round"
				stroke-linejoin="round"
			/>
		)
	}
	{
		name === 'briefcase' && (
			<>
				<path
					d="M8 7V5.8A1.8 1.8 0 0 1 9.8 4h4.4A1.8 1.8 0 0 1 16 5.8V7"
					stroke="currentColor"
					stroke-width={stroke}
					stroke-linecap="round"
				/>
				<rect
					x="4"
					y="7"
					width="16"
					height="13"
					rx="2"
					stroke="currentColor"
					stroke-width={stroke}
				/>
				<path
					d="M4 12h16"
					stroke="currentColor"
					stroke-width={stroke}
					stroke-linecap="round"
				/>
			</>
		)
	}
	{
		name === 'calendar' && (
			<>
				<rect
					x="4"
					y="5.5"
					width="16"
					height="14.5"
					rx="2"
					stroke="currentColor"
					stroke-width={stroke}
				/>
				<path
					d="M8 3.5v4M16 3.5v4M4 10.5h16"
					stroke="currentColor"
					stroke-width={stroke}
					stroke-linecap="round"
				/>
			</>
		)
	}
	{
		name === 'status' && (
			<>
				<circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width={stroke} />
				<circle cx="12" cy="12" r="2.75" fill="currentColor" />
			</>
		)
	}
	{
		name === 'layers' && (
			<>
				<path
					d="m4.5 9 7.5 3.5L19.5 9 12 5.5 4.5 9Z"
					stroke="currentColor"
					stroke-width={stroke}
					stroke-linejoin="round"
				/>
				<path
					d="m4.5 13.2 7.5 3.5 7.5-3.5"
					stroke="currentColor"
					stroke-width={stroke}
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
				<path
					d="m4.5 17 7.5 3.5L19.5 17"
					stroke="currentColor"
					stroke-width={stroke}
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</>
		)
	}
	{
		name === 'work' && (
			<>
				<path
					d="M4 8.5h16v10A1.5 1.5 0 0 1 18.5 20h-13A1.5 1.5 0 0 1 4 18.5v-10Z"
					stroke="currentColor"
					stroke-width={stroke}
					stroke-linejoin="round"
				/>
				<path
					d="M9 8.5V6.8A1.8 1.8 0 0 1 10.8 5h2.4A1.8 1.8 0 0 1 15 6.8v1.7"
					stroke="currentColor"
					stroke-width={stroke}
				/>
				<path
					d="M4 12.5h16"
					stroke="currentColor"
					stroke-width={stroke}
					stroke-linecap="round"
				/>
			</>
		)
	}
	{
		name === 'spark' && (
			<path
				d="M12 3.5 13.4 9l5.1.4-3.9 3.2 1.3 5.1L12 14.9l-3.9 2.8 1.3-5.1-3.9-3.2L10.6 9 12 3.5Z"
				stroke="currentColor"
				stroke-width={stroke}
				stroke-linejoin="round"
			/>
		)
	}
</svg>
