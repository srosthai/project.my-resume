---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/react/ThemeToggle';
import SiteBrand from '../components/react/SiteBrand';
import Icon from '../components/Icon.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'SROS THAI — Projects',
	description = 'Explore projects showcasing skills in web development and design.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content="SROS THAI" />
		<script is:inline>
			(() => {
				const readTheme = () => {
					try {
						const stored = localStorage.getItem('theme');
						if (stored === 'light' || stored === 'dark') return stored;
					} catch {
						/* ignore */
					}
					return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
				};

				const applyTheme = (doc = document) => {
					doc.documentElement.setAttribute('data-theme', readTheme());
				};

				applyTheme();
				document.addEventListener('astro:before-swap', (event) => {
					applyTheme(event.newDocument);
				});
				document.addEventListener('astro:after-swap', () => {
					applyTheme();
				});
			})();
		</script>
		<ClientRouter />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<div class="site-shell">
			<header class="site-header" transition:persist>
				<SiteBrand />
				<div class="site-header__end">
					<a
						class="site-header__link"
						href="https://www.srosthai.me"
						target="_blank"
						rel="noreferrer"
					>
						<span>Portfolio</span>
						<Icon name="external" size={14} />
					</a>
					<ThemeToggle client:load />
				</div>
			</header>
			<main class="site-main">
				<slot />
			</main>
		</div>
	</body>
</html>
