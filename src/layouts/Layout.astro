---
import '../styles/global.css';
import ThemeToggle from '../components/react/ThemeToggle';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'SROS THAI — Projects',
	description = 'Explore projects showcasing skills in web development and design.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content="SROS THAI" />
		<script is:inline>
			(() => {
				try {
					const stored = localStorage.getItem('theme');
					const theme =
						stored === 'light' || stored === 'dark'
							? stored
							: window.matchMedia('(prefers-color-scheme: light)').matches
								? 'light'
								: 'dark';
					document.documentElement.setAttribute('data-theme', theme);
				} catch {
					document.documentElement.setAttribute('data-theme', 'dark');
				}
			})();
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<div class="site-shell">
			<header class="site-header">
				<a class="site-brand" href="/">
					<span class="site-brand__name">SROS THAI</span>
					<span class="site-brand__role">Full Stack Developer</span>
				</a>
				<div class="site-header__end">
					<ThemeToggle client:load />
				</div>
			</header>
			<main class="site-main">
				<slot />
			</main>
		</div>
	</body>
</html>
