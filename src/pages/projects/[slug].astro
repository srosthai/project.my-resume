---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import CoverLightbox from '../../components/react/CoverLightbox';
import { getProject, getProjectSlugs, projects } from '../../data/projects';

export function getStaticPaths() {
	return getProjectSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const project = getProject(slug!);

if (!project) {
	return Astro.redirect('/');
}

const index = projects.findIndex((p) => p.slug === project.slug);
const prev = projects[(index - 1 + projects.length) % projects.length];
const next = projects[(index + 1) % projects.length];
const metaDescription =
	project.summary.length > 160 ? `${project.summary.slice(0, 157).trim()}…` : project.summary;

type Block =
	| { kind: 'paragraph'; text: string }
	| { kind: 'bullets'; items: string[] }
	| { kind: 'tech'; items: string[] };

function parseBody(body: string[]): Block[] {
	const blocks: Block[] = [];

	for (const entry of body) {
		let bullets: string[] | null = null;

		for (const rawLine of entry.split(/\r?\n/)) {
			const line = rawLine.trim();
			if (!line) {
				bullets = null;
				continue;
			}

			if (line.startsWith('- ')) {
				const item = line.slice(2).trim();
				if (!item) continue;
				if (!bullets) {
					bullets = [];
					blocks.push({ kind: 'bullets', items: bullets });
				}
				bullets.push(item);
				continue;
			}

			bullets = null;

			if (/^Tech:\s*/i.test(line)) {
				const items = line
					.replace(/^Tech:\s*/i, '')
					.split(',')
					.map((item) => item.trim())
					.filter(Boolean);
				if (items.length) blocks.push({ kind: 'tech', items });
			} else {
				blocks.push({ kind: 'paragraph', text: line });
			}
		}
	}

	return blocks;
}

const blocks = parseBody(project.body);
const hasTechBlock = blocks.some((block) => block.kind === 'tech');

function linkIcon(label: string): 'github' | 'external' {
	return /github/i.test(label) ? 'github' : 'external';
}
---

<Layout title={`${project.title} — SROS THAI`} description={metaDescription}>
	<article class="detail">
		<a class="back-link" href="/">
			<Icon name="arrow-left" size={16} />
			<span>Back to projects</span>
		</a>

		<header class="detail__header">
			<p class="detail__pill">{project.subtitle}</p>
			<h1
				class="detail__title"
				style={`--vt-name: project-title-${project.slug}`}
			>
				{project.title}
			</h1>
			<p class="detail__lead">{project.summary}</p>

			<dl class="detail__facts">
				<div class="detail__fact">
					<dt>
						<Icon name="briefcase" size={14} />
						<span>Role</span>
					</dt>
					<dd>{project.role}</dd>
				</div>
				<div class="detail__fact">
					<dt>
						<Icon name="calendar" size={14} />
						<span>Year</span>
					</dt>
					<dd>{project.year}</dd>
				</div>
				<div class="detail__fact">
					<dt>
						<Icon name="status" size={14} />
						<span>Status</span>
					</dt>
					<dd class="detail__status" data-status={project.status}>{project.status}</dd>
				</div>
			</dl>
		</header>

		<CoverLightbox
			client:load
			src={project.cover}
			alt={project.coverAlt}
			transitionName={`project-cover-${project.slug}`}
		/>

		<div class="detail__content">
			{
				blocks.map((block) => {
					if (block.kind === 'paragraph') {
						return <p>{block.text}</p>;
					}

					if (block.kind === 'bullets') {
						return (
							<ul class="detail__bullets">
								{block.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						);
					}

					return (
						<ul class="detail__tags" aria-label="Tech stack">
							{block.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					);
				})
			}

			{
				!hasTechBlock && project.stack.length > 0 && (
					<div class="detail__stack-block">
						<h2 class="detail__section-title">Stack</h2>
						<ul class="detail__tags" aria-label="Tech stack">
							{project.stack.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
				)
			}
		</div>

		{
			project.links.length > 0 && (
				<div class="detail__actions">
					{project.links.map((link) => (
						<a
							class:list={[
								'btn',
								linkIcon(link.label) === 'github' ? 'btn--ghost' : 'btn--primary',
							]}
							href={link.href}
							target="_blank"
							rel="noreferrer"
						>
							<Icon name={linkIcon(link.label)} size={16} />
							<span>{link.label}</span>
						</a>
					))}
				</div>
			)
		}

		<nav class="detail__pager" aria-label="Adjacent projects">
			<a class="pager-link" href={`/projects/${prev.slug}/`}>
				<Icon name="arrow-left" size={16} />
				<span class="pager-link__copy">
					<span class="pager-link__label">Previous</span>
					<span class="pager-link__title">{prev.title}</span>
				</span>
			</a>
			<a class="pager-link pager-link--next" href={`/projects/${next.slug}/`}>
				<span class="pager-link__copy">
					<span class="pager-link__label">Next</span>
					<span class="pager-link__title">{next.title}</span>
				</span>
				<Icon name="arrow-right" size={16} />
			</a>
		</nav>
	</article>
</Layout>
