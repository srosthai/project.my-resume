---
import Layout from '../layouts/Layout.astro';
import ProjectGallery from '../components/react/ProjectGallery';
import { projects } from '../data/projects';
import {
	DEFAULT_OG_IMAGE,
	FALLBACK_SITE_URL,
	HOME_DESCRIPTION,
	HOME_TITLE,
	homeGraph,
} from '../lib/seo';

const site = Astro.site ?? new URL(FALLBACK_SITE_URL);
const canonical = new URL(Astro.url.pathname, site).href;
const jsonLd = homeGraph(site, canonical, new URL(DEFAULT_OG_IMAGE, site).href, projects);

const galleryProjects = projects.map((p) => ({
	slug: p.slug,
	title: p.title,
	subtitle: p.subtitle,
	summary: p.summary,
	cover: p.cover,
	coverAlt: p.coverAlt,
}));
---

<Layout
	title={HOME_TITLE}
	description={HOME_DESCRIPTION}
	type="profile"
	jsonLd={jsonLd}
>
	<section class="home-intro" aria-labelledby="work-heading">
		<div class="home-intro__eyebrow">
			<span>Portfolio</span>
			<span aria-hidden="true">/</span>
			<span>{projects.length} projects</span>
		</div>
		<h1 id="work-heading" class="home-intro__title">Selected work</h1>
		<p class="home-intro__lead">Browse the work to explore each project.</p>
	</section>

	<ProjectGallery client:load projects={galleryProjects} />
</Layout>
